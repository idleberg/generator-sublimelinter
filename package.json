{
	"name": "generator-sublimelinter",
	"version": "0.4.3",
	"description": "Yeoman generator for SublimeLinter plugins",
	"author": "Jan T. Sott",
	"license": "MIT",
	"keywords": [
		"yeoman-generator",
		"sublimelinter",
		"sublimelinter-plugin",
		"sublime text"
	],
	"type": "module",
	"exports": "./generators/app/index.js",
	"files": [
		"generators",
		"lib",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"lint:e18e": "e18e-cli analyze",
		"lint:code": "biome check",
		"lint": "concurrently --prefix '{name}' -c 'green,blue' 'npm:lint:*'",
		"publish:npm": "np",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/generator-sublimelinter.git"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@idleberg/yeoman-generator": "^0.3.0",
		"@sindresorhus/slugify": "^3.0.0",
		"change-case": "^5.4.4",
		"semver": "^7.8.0",
		"spdx-license-list": "^6.11.0",
		"terminal-link": "^5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@idleberg/configs": "^0.4.2",
		"@types/node": "^24.10.4",
		"@types/yeoman-assert": "^3.1.4",
		"@yeoman/adapter": "^4.0.2",
		"@yeoman/types": "^1.11.1",
		"concurrently": "^9.2.1",
		"kleur": "^4.1.5",
		"mem-fs": "^4.1.4",
		"np": "^11.2.1",
		"vitest": "^4.1.6",
		"yeoman-assert": "^3.1.1",
		"yeoman-environment": "^6.1.0",
		"yeoman-generator": "^8.2.2",
		"yeoman-test": "^11.5.2"
	},
	"packageManager": "pnpm@11.1.3"
}
